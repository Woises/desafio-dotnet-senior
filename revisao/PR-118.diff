diff --git a/db/migrations/V001__seq_numero_nfse.sql b/db/migrations/V001__seq_numero_nfse.sql
new file mode 100644
index 0000000..21ef812
--- /dev/null
+++ b/db/migrations/V001__seq_numero_nfse.sql
@@ -0,0 +1,14 @@
+SET DEFINE OFF
+WHENEVER SQLERROR EXIT FAILURE
+
+-- numero da NFS-e passa a vir de sequence, sem varrer a NFSE a cada emissao
+DECLARE
+    v_inicio NUMBER;
+BEGIN
+    SELECT NVL(MAX(NUMERO), 0) + 1 INTO v_inicio FROM NFSE;
+    EXECUTE IMMEDIATE 'CREATE SEQUENCE SEQ_NFSE_NUMERO START WITH ' || v_inicio ||
+                      ' INCREMENT BY 1 CACHE 100';
+END;
+/
+
+EXIT
