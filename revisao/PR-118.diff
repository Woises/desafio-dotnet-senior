diff --git a/legado/tests/NotaCarioca.Testes/CalculoIssArredondamentoTests.cs b/legado/tests/NotaCarioca.Testes/CalculoIssArredondamentoTests.cs
new file mode 100644
index 0000000..a38a09b
--- /dev/null
+++ b/legado/tests/NotaCarioca.Testes/CalculoIssArredondamentoTests.cs
@@ -0,0 +1,46 @@
+using Microsoft.VisualStudio.TestTools.UnitTesting;
+using NotaCarioca.Dominio;
+
+namespace NotaCarioca.Testes
+{
+    [TestClass]
+    public class CalculoIssArredondamentoTests
+    {
+        [TestMethod]
+        public void Iss_Aliquota5_BaseInteira()
+        {
+            Assert.AreEqual(25m, CalculoIss.CalcularValorIss(500m, 0.05m, "N"));
+        }
+
+        [TestMethod]
+        public void Iss_Aliquota2_TerceiraCasaAbaixoDeCinco()
+        {
+            Assert.AreEqual(2.00m, CalculoIss.CalcularValorIss(100.04m, 0.02m, "N"));
+        }
+
+        [TestMethod]
+        public void Iss_Aliquota3_TerceiraCasaAcimaDeCinco()
+        {
+            Assert.AreEqual(3.01m, CalculoIss.CalcularValorIss(100.30m, 0.03m, "N"));
+        }
+
+        [TestMethod]
+        public void Iss_SemAliquota_Zero()
+        {
+            Assert.AreEqual(0m, CalculoIss.CalcularValorIss(1000m, 0m, "N"));
+        }
+
+        [TestMethod]
+        public void Iss_Mei_IgnoraAliquota()
+        {
+            Assert.AreEqual(0m, CalculoIss.CalcularValorIss(2500m, 0.05m, "M"));
+        }
+
+        [TestMethod]
+        public void Iss_BaseComDeducoes()
+        {
+            decimal baseCalculo = CalculoIss.CalcularBase(1500m, 500m);
+            Assert.AreEqual(20m, CalculoIss.CalcularValorIss(baseCalculo, 0.02m, "N"));
+        }
+    }
+}
